# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js ───────────────────────────────────────────────────────────────────
.next/
out/
build/
.vercel/

# ─── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Testing ───────────────────────────────────────────────────────────────────
coverage/

# ─── Environment / Secrets ─────────────────────────────────────────────────────
# ALL .env files are ignored except .env.example (safe template)
.env
.env.*
!.env.example

# ─── SQLite Database ───────────────────────────────────────────────────────────
# Keep the data/ directory but never commit the database itself
data/*.db
data/*.db-shm
data/*.db-wal

# ─── SSL Certificates ──────────────────────────────────────────────────────────
# Match certs anywhere in the tree (nginx/ssl/, etc.)
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.cer
**/*.der
nginx/ssl/*
!nginx/ssl/.gitkeep

# ─── Debug / Logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ─── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Linux ─────────────────────────────────────────────────────────────────────
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ─── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vim/

# ─── Docker override files (local only) ────────────────────────────────────────
docker-compose.override.yml
docker-compose.local.yml
