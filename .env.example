# Admin dashboard password
ADMIN_PASSWORD=your-secure-password-here

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Your deployed site URL
NEXTAUTH_URL=https://gwhyyy.com

# Optional: email notification for new inquiries (via resend.com).
# If unset, inquiries are still stored in the dashboard; the API reports
# email_status=not_configured. CONTACT_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=portfolio@gwhyyy.com
CONTACT_TO_EMAIL=work@gwhyyy.com

# Optional: bearer token for agent/MCP access to /api/prospects.
# Generate with: openssl rand -hex 32
OUTREACH_API_TOKEN=
# Verified outreach sender (separate from transactional inquiries)
OUTREACH_FROM_EMAIL=hello@outreach.gwhyyy.com
OUTREACH_REPLY_TO=work@gwhyyy.com
# Bearer token for the gwhyyy admin MCP bridge (messages, analytics, content)
DASHBOARD_API_TOKEN=

# Provider secrets belong in ~/.config/gwhyyy/email.env (chmod 600), not here.
# Compose reads that optional file; override its path with OUTREACH_SECRETS_FILE.
# Keys: BULKO_API_KEY or OUTREACH_SMTP_HOST, OUTREACH_SMTP_PORT,
# OUTREACH_SMTP_USER, OUTREACH_SMTP_PASSWORD. SMTP always requires TLS.
# The dashboard stores only non-secret sender/safety settings.
# Optional DB override for isolated tests; leave unset in production.
# DATABASE_PATH=/tmp/opencode/gwhyyy-test.db
