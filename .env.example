# Admin dashboard password
ADMIN_PASSWORD=your-secure-password-here

# NextAuth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# Your deployed site URL
NEXTAUTH_URL=https://gwhyyy.com

# Optional: email notification for new leads (via resend.com).
# If unset, leads are still stored in the dashboard — no email is sent.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=portfolio@yourdomain.com
CONTACT_TO_EMAIL=work@gwhyyy.com
